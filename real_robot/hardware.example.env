# Copy to hardware.local.env, edit, then: set -a; source hardware.local.env; set +a
ROBOT_IP=CHANGE_ME
CATKIN_WS=/path/to/catkin_ws
FRANKA_SERVER_URL=http://127.0.0.1:5000/
REALSENSE_SERIAL=CHANGE_ME
LEAP_SERIAL_PORT=/dev/serial/by-id/CHANGE_ME
# Preserve the current pi offsets; calibrate hardware before any motion.
HF_HOME=/path/to/model_cache
